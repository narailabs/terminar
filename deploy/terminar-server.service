# terminar-server.service
#
# Systemd unit file for the terminar Server.
#
# Installation:
#   1. Copy this file to /etc/systemd/system/terminar-server.service
#   2. Create environment file: /etc/terminar-server/env
#   3. Create the service user:
#      sudo useradd --system --no-create-home --shell /usr/sbin/nologin terminar
#   4. Reload systemd: sudo systemctl daemon-reload
#   5. Enable and start: sudo systemctl enable --now terminar-server
#
# Configuration via environment file (/etc/terminar-server/env):
#   TERMINAR_PORT=6749
#   TERMINAR_LOG_LEVEL=info
#   TERMINAR_LOG_FILE=/var/log/terminar-server/server.log
#   TERMINAR_LOG_JSON=true
#   TERMINAR_PERSIST_SESSIONS=true
#   TERMINAR_CORS_ORIGINS=http://localhost:6749,http://localhost:5173

[Unit]
Description=terminar Server - Terminal session multiplexer
Documentation=https://github.com/narai/terminar-server
After=network.target
Wants=network.target

[Service]
Type=simple
User=terminar
Group=terminar

# Binary path - override in env file if installed elsewhere
ExecStart=/usr/local/bin/terminar-server \
    --port ${TERMINAR_PORT:-6749} \
    --log-level ${TERMINAR_LOG_LEVEL:-info}

# Environment configuration
EnvironmentFile=-/etc/terminar-server/env

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

# Graceful shutdown: send SIGTERM, wait 10s, then SIGKILL
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true

# Allow write access to specific directories
ReadWritePaths=/var/log/terminar-server
ReadWritePaths=/var/run/terminar-server
ReadWritePaths=/tmp/terminar-history
ReadWritePaths=/tmp/terminar-sessions.json

# Runtime directory for unix socket and PID
RuntimeDirectory=terminar-server
RuntimeDirectoryMode=0750

# Logging directory
LogsDirectory=terminar-server
LogsDirectoryMode=0750

# State directory for persisted sessions
StateDirectory=terminar-server
StateDirectoryMode=0750

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Socket activation readiness notification
# The server can notify systemd when ready via sd_notify
# (requires sd-notify crate integration in the binary)
NotifyAccess=main

# Standard output/error go to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminar-server

[Install]
WantedBy=multi-user.target
