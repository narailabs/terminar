# terminar-gateway.service
#
# Systemd unit file for the termiNar Gateway.
#
# The gateway is a multi-user reverse proxy that authenticates clients
# and spawns per-user terminar-server instances via sudo.
#
# Installation:
#   1. Copy this file to /etc/systemd/system/terminar-gateway.service
#   2. Create environment file: /etc/terminar-gateway/env
#   3. Create the service user:
#      sudo useradd --system --create-home --shell /usr/sbin/nologin terminar
#   4. Install sudoers fragment: deploy/terminar-sudoers -> /etc/sudoers.d/terminar
#   5. Create socket directory: sudo mkdir -p /run/terminar && sudo chown terminar:terminar /run/terminar
#   6. Reload systemd: sudo systemctl daemon-reload
#   7. Enable and start: sudo systemctl enable --now terminar-gateway
#
# Configuration via environment file (/etc/terminar-gateway/env):
#   TERMINAR_GW_PORT=3000
#   TERMINAR_GW_TLS_PORT=8444
#   TERMINAR_GW_LOG_LEVEL=info
#   TERMINAR_GW_AUDIT_LEVEL=standard
#   TERMINAR_GW_IDLE_TIMEOUT=1800

[Unit]
Description=termiNar Gateway - Multi-user terminal session proxy
Documentation=https://github.com/narai/terminar
After=network.target
Wants=network.target

[Service]
Type=simple
User=terminar
Group=terminar

ExecStart=/usr/local/bin/terminar-gateway \
    --port ${TERMINAR_GW_PORT:-3000} \
    --tls-port ${TERMINAR_GW_TLS_PORT:-8444} \
    --auto-tls \
    --server-bin /usr/local/bin/terminar-server \
    --socket-dir /run/terminar \
    --idle-timeout ${TERMINAR_GW_IDLE_TIMEOUT:-1800} \
    --audit-level ${TERMINAR_GW_AUDIT_LEVEL:-standard} \
    --log-level ${TERMINAR_GW_LOG_LEVEL:-info}

# Environment configuration
EnvironmentFile=-/etc/terminar-gateway/env

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security hardening
# Note: NoNewPrivileges is NOT set because the gateway needs to run
# sudo to spawn per-user servers. ProtectHome is also relaxed because
# per-user servers write to ~/.terminar/.
ProtectSystem=strict
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true

# Allow write access for gateway operations
ReadWritePaths=/run/terminar
ReadWritePaths=/home

# Runtime directory for per-user server sockets
RuntimeDirectory=terminar
RuntimeDirectoryMode=0750

# Resource limits (higher than single-server: handles multiple users)
LimitNOFILE=65536
LimitNPROC=8192

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminar-gateway

[Install]
WantedBy=multi-user.target
