{
  "name": "@narai/terminar-darwin-arm64",
  "version": "0.3.0",
  "description": "terminar server binary for macOS ARM64 (Apple Silicon)",
  "os": ["darwin"],
  "cpu": ["arm64"],
  "files": ["bin/"],
  "scripts": {
    "postinstall": "node -e \"const{execSync:e}=require('child_process');try{e('chmod +x bin/terminar-server')}catch(x){}try{e('xattr -d com.apple.quarantine bin/terminar-server 2>/dev/null')}catch(x){}try{e('codesign --force --sign - bin/terminar-server')}catch(x){}\""
  },
  "license": "MIT"
}
