{
  "name": "terminar",
  "version": "0.0.1",
  "private": true,
  "description": "terminar - Persistent terminal sessions with Electron and VS Code extension frontends",
  "scripts": {
    "server:build": "cd server && cargo build --release",
    "server:dev": "cd server && PATH=\"$HOME/.cargo/bin:$PATH\" cargo run --bin terminar-server -- --no-auth",
    "tray:dev": "cd tray && pnpm dev",
    "tray:build": "cd tray && pnpm build:electron",
    "dev": "concurrently -k -n server,tray -c blue,magenta \"pnpm server:dev\" \"pnpm wait-then:tray\"",
    "dev:tray": "concurrently -k -n server,tray -c blue,magenta \"pnpm server:dev\" \"pnpm wait-then:tray\"",
    "wait-then:tray": "wait-on http-get://localhost:6749/health && pnpm tray:dev",
    "build": "pnpm server:build && cd tray && pnpm build:electron",
    "test": "cd server && cargo test",
    "test:server": "cd server && cargo test",
    "test:extension": "cd extension && pnpm test",
    "tray:test": "cd tray && pnpm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
